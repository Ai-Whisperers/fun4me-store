# =============================================================================
# Docker Ignore - Vete Platform
# =============================================================================
# Files and directories to exclude from Docker build context
# =============================================================================

# Git
.git
.gitignore

# Dependencies (installed fresh in container)
node_modules
web/node_modules
**/node_modules

# Build outputs (generated in container)
.next
web/.next
out
web/out
dist
web/dist

# Development files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Environment files (should be passed at runtime)
.env
.env.*
!.env.example
web/.env
web/.env.*
!web/.env.example

# IDE and editor
.idea
.vscode
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Testing
coverage
web/coverage
.nyc_output
playwright-report
web/playwright-report
test-results
web/test-results

# Documentation (not needed in production)
docs
documentation
*.md
!README.md

# Scripts (development only)
scripts

# Supabase (local development)
supabase/.branches
supabase/.temp

# Claude/AI config
.claude
.antigravity
.opencode
.obsidian

# Metrics and reports
metrics
critique
*.txt
!requirements.txt

# Screenshots
screenshots

# Conductor (separate service)
conductor

# Template files
opencode-template

# Misc
*.tar
*.tar.gz
*.zip
Makefile
