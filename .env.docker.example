# =============================================================================
# Vete Platform - Docker Environment Variables
# =============================================================================
#
# IMPORTANT: This application REQUIRES Supabase Cloud
#
# The codebase uses Supabase for:
#   - Authentication (JWT sessions, user management)
#   - Database with Row-Level Security (RLS)
#   - Storage (file uploads)
#
# RLS policies use auth.uid() which is Supabase-specific.
# Self-hosted PostgreSQL will NOT work without significant code changes.
#
# =============================================================================

# =============================================================================
# SUPABASE CONFIGURATION [REQUIRED]
# =============================================================================
# Get these from your Supabase project dashboard: Settings > API
# Without these, the application WILL NOT FUNCTION

# Supabase project URL (e.g., https://xxxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase anonymous key - safe for client-side (RLS protected)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase service role key - SERVER ONLY, bypasses RLS
# Required for: background jobs, admin operations, seeding
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Direct PostgreSQL connection (from Supabase dashboard: Settings > Database)
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.xxxxx:your-password@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
APP_PORT=3000
NODE_ENV=production
TZ=America/Asuncion

# Your public URL (update for production/Cloudflare tunnel)
NEXT_PUBLIC_APP_URL=https://vete.ai-whisperers.org
NEXT_PUBLIC_BASE_URL=https://vete.ai-whisperers.org

# =============================================================================
# REDIS CACHE (Local Docker)
# =============================================================================
# Redis runs locally in Docker for caching
REDIS_PORT=6379

# =============================================================================
# CLOUDFLARE TUNNEL [REQUIRED FOR PRODUCTION]
# =============================================================================
# Create tunnel: cloudflared tunnel create vete
# Get token: cloudflared tunnel token vete
CLOUDFLARE_TUNNEL_TOKEN=your-tunnel-token-here

# =============================================================================
# EMAIL CONFIGURATION
# =============================================================================
# Without email config, emails are logged but not sent (graceful fallback)
EMAIL_PROVIDER=resend
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM=noreply@ai-whisperers.org
EMAIL_FROM_NAME=Vete Platform

# =============================================================================
# STRIPE PAYMENTS (Optional)
# =============================================================================
# Required only if billing features are enabled
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# =============================================================================
# BACKGROUND JOBS - Inngest (Optional)
# =============================================================================
# Without Inngest, use cron endpoints manually via curl/scheduler
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# =============================================================================
# CRON JOB SECURITY [REQUIRED]
# =============================================================================
# Generate with: openssl rand -base64 32
# Used to authenticate cron endpoint calls
CRON_SECRET=your-cron-secret-here

# =============================================================================
# FEATURE FLAGS
# =============================================================================
ENABLE_STORE=true
ENABLE_WHATSAPP=false
ENABLE_HOSPITALIZATION=true
ENABLE_LAB=true
ENABLE_INSURANCE=false

# =============================================================================
# RATE LIMITING
# =============================================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000

# =============================================================================
# MONITORING (Optional)
# =============================================================================
MONITORING_ENABLED=false
NEXT_PUBLIC_SENTRY_DSN=
