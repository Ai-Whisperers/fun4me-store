{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix --max-warnings 9000"
    ],
    "*.{json,md,css}": [
      "prettier --write --ignore-unknown"
    ]
  },
  "scripts": {
    "prepare": "husky",
    "dev": "next dev",
    "build": "NODE_OPTIONS='--max_old_space_size=8192' next build",
    "build:analyze": "ANALYZE=true next build",
    "start": "next start",
    "lint": "eslint --max-warnings 800",
    "lint:fix": "eslint --fix",
    "lint:strict": "eslint --max-warnings 0",
    "lint:baseline": "eslint 2>&1 | tee eslint-baseline.txt",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc --noEmit --project tsconfig.test.json || true",
    "typecheck:scripts": "tsc --noEmit --project tsconfig.scripts.json || true",
    "typecheck:all": "npm run typecheck && npm run typecheck:tests && npm run typecheck:scripts",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "test": "npm run test:unit",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:api && npm run test:e2e",
    "test:watch": "vitest watch",
    "test:unit": "vitest run tests/unit tests/services --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts --coverage",
    "test:components": "vitest run --config vitest.config.components.ts",
    "test:components:watch": "vitest watch --config vitest.config.components.ts",
    "test:components:coverage": "vitest run --config vitest.config.components.ts --coverage",
    "test:database": "vitest run --config vitest.config.database.ts",
    "test:database:watch": "vitest watch --config vitest.config.database.ts",
    "test:database:coverage": "vitest run --config vitest.config.database.ts --coverage",
    "test:system": "vitest run tests/system --coverage",
    "test:functionality": "vitest run tests/functionality --coverage",
    "test:uat": "vitest run tests/uat --coverage",
    "test:api": "vitest run --config vitest.config.api.ts",
    "test:api:watch": "vitest watch --config vitest.config.api.ts",
    "test:api:coverage": "vitest run --config vitest.config.api.ts --coverage",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:critical": "vitest run --testPathPattern='critical' && playwright test --grep '@critical'",
    "test:smoke": "vitest run tests/unit && playwright test e2e/public",
    "test:feature:pets": "vitest run --testPathPattern='pets' && playwright test --grep 'pets'",
    "test:feature:booking": "vitest run --testPathPattern='booking|appointment'",
    "test:feature:vaccines": "vitest run --testPathPattern='vaccine'",
    "test:feature:inventory": "vitest run --testPathPattern='inventory'",
    "test:feature:finance": "vitest run --testPathPattern='finance|expense'",
    "test:feature:medical": "vitest run --testPathPattern='medical-records|prescription'",
    "test:feature:store": "vitest run --testPathPattern='store|cart|product' && playwright test e2e/store",
    "test:security": "vitest run tests/security --coverage",
    "test:public": "playwright test e2e/public",
    "test:store": "playwright test e2e/store",
    "test:portal": "playwright test e2e/portal",
    "test:dashboard": "playwright test e2e/dashboard",
    "test:tools": "playwright test e2e/tools",
    "screenshots": "npx playwright test e2e/screenshots.spec.ts",
    "screenshots:owner": "ROLE=owner npx playwright test e2e/screenshots.spec.ts",
    "screenshots:vet": "ROLE=vet npx playwright test e2e/screenshots.spec.ts",
    "screenshots:admin": "ROLE=admin npx playwright test e2e/screenshots.spec.ts",
    "screenshots:public": "ROLE=public npx playwright test e2e/screenshots.spec.ts",
    "screenshots:all": "npx tsx scripts/screenshots/run-all.ts",
    "screenshots:capture": "npx tsx scripts/screenshots/capture.ts",
    "test:coverage": "vitest run --coverage",
    "test:coverage:html": "vitest run --coverage --coverage.reporter=html",
    "test:performance": "vitest run tests/performance --reporter=verbose",
    "test:performance:baseline": "vitest run tests/performance/baseline.performance.test.ts --reporter=verbose",
    "test:performance:compare": "npx tsx tests/performance/compare-baseline.ts",
    "test:load": "vitest run --config vitest.load.config.ts",
    "test:load:appointments": "vitest run --config vitest.load.config.ts tests/load/appointment-booking-concurrency.test.ts",
    "test:db:reset": "node scripts/reset-test-db.js",
    "test:db:seed": "node scripts/seed-test-db.js",
    "test:db:setup": "npm run test:db:reset && npm run test:db:seed",
    "test:db:cleanup": "npx tsx scripts/cleanup-test-db.ts",
    "test:db:cleanup:dry": "npx tsx scripts/cleanup-test-db.ts --dry-run",
    "sync:images": "npx tsx scripts/sync-clinic-images.ts",
    "sync:images:watch": "npx tsx scripts/sync-clinic-images.ts --watch",
    "inventory:template": "npx tsx scripts/generate-inventory-template.ts",
    "inventory:gsheet:create": "npx tsx scripts/sync-inventory-template-gsheet.ts --create",
    "inventory:gsheet:update": "npx tsx scripts/sync-inventory-template-gsheet.ts --update",
    "db:setup": "node db/setup-db.mjs full",
    "db:schema": "node db/setup-db.mjs schema",
    "db:clean": "node db/setup-db.mjs clean",
    "seed": "npx tsx db/seeds/scripts/seed.ts",
    "seed:basic": "npx tsx db/seeds/scripts/seed.ts --type basic",
    "seed:reference": "npx tsx db/seeds/scripts/seed.ts --type reference",
    "seed:full": "npx tsx db/seeds/scripts/seed.ts --type full",
    "seed:demo": "npx tsx db/seeds/scripts/seed.ts --type demo",
    "seed:clear": "npx tsx db/seeds/scripts/seed.ts --clear --type demo",
    "seed:reset": "npx tsx db/seeds/scripts/seed.ts --clear --type demo",
    "seed:dashboard": "npx tsx scripts/seed-dashboard-test-data.ts",
    "seed:v2": "npx tsx db/seeds/scripts/seed-v2.ts",
    "seed:v2:basic": "npx tsx db/seeds/scripts/seed-v2.ts --variant basic",
    "seed:v2:integration": "npx tsx db/seeds/scripts/seed-v2.ts --variant integration",
    "seed:v2:e2e": "npx tsx db/seeds/scripts/seed-v2.ts --variant e2e",
    "seed:v2:demo": "npx tsx db/seeds/scripts/seed-v2.ts --variant demo",
    "seed:v2:reset": "npx tsx db/seeds/scripts/seed-v2.ts --variant reset",
    "seed:v2:dry-run": "npx tsx db/seeds/scripts/seed-v2.ts --variant demo --dry-run",
    "seed:v2:verbose": "npx tsx db/seeds/scripts/seed-v2.ts --variant demo --verbose",
    "seed:v2:terrapet": "npx tsx db/seeds/scripts/seed-v2.ts --variant demo --tenant terrapet",
    "seed:v2:petlife": "npx tsx db/seeds/scripts/seed-v2.ts --variant demo --tenant petlife",
    "seed:v2:all": "npx tsx db/seeds/scripts/seed-v2.ts --variant demo --tenants terrapet,petlife",
    "seed:demo-data": "npx tsx db/seeds/scripts/seed-demo-data.ts",
    "seed:demo-data:all": "npx tsx db/seeds/scripts/seed-demo-data.ts --tenants terrapet,petlife --verbose",
    "demo:reset": "npx tsx scripts/reset-demo-clinic.ts",
    "demo:seed": "npx tsx scripts/seed-demo-clinic.ts",
    "demo:prep": "npm run demo:reset && echo '\n🎬 Demo ready! Access: [domain]/terapet'",
    "db:fixes": "node db/setup-db.mjs fixes",
    "reset-dev": "powershell -ExecutionPolicy Bypass -File reset-dev.ps1",
    "kill-node": "powershell -ExecutionPolicy Bypass -File kill-node.ps1 -Force",
    "update:images": "npx tsx scripts/update-product-images.ts",
    "update:images:dry-run": "npx tsx scripts/update-product-images.ts --dry-run --verbose",
    "validate:configs": "npx tsx scripts/validate-clinic-configs.ts",
    "validate:configs:fix": "npx tsx scripts/validate-clinic-configs.ts --fix",
    "migrate:auth": "npx tsx scripts/migrate-api-auth.ts",
    "domains": "node ../scripts/domains.mjs",
    "domains:list": "node ../scripts/domains.mjs list",
    "domains:validate": "node ../scripts/domains.mjs validate",
    "domains:verify": "node ../scripts/domains.mjs verify",
    "domains:sync": "node ../scripts/domains.mjs sync-vercel",
    "domains:sync:dry": "node ../scripts/domains.mjs sync-vercel --dry-run",
    "domains:cloudflare": "node ../scripts/domains.mjs generate-cloudflare"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@react-pdf/renderer": "^4.3.2",
    "@sentry/nextjs": "^10.32.1",
    "@stripe/react-stripe-js": "^5.4.1",
    "@stripe/stripe-js": "^8.6.3",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.93.3",
    "@tanstack/react-query": "^5.90.19",
    "@types/pg": "^8.16.0",
    "@types/qrcode": "^1.5.6",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.36.2",
    "@vercel/analytics": "^1.6.1",
    "@vercel/speed-insights": "^1.3.1",
    "autoprefixer": "^10.4.24",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "dompurify": "^3.3.1",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.1",
    "exceljs": "^4.4.0",
    "framer-motion": "^12.23.26",
    "html5-qrcode": "^2.3.8",
    "inngest": "^3.49.3",
    "leaflet": "^1.9.4",
    "lodash.merge": "^4.6.2",
    "lucide-react": "^0.562.0",
    "next": "^15.1.11",
    "next-intl": "^4.7.0",
    "pg": "^8.16.3",
    "postcss": "^8.5.6",
    "postgres": "^3.4.8",
    "qrcode": "^1.5.4",
    "react": "^19.2.3",
    "react-big-calendar": "^1.19.4",
    "react-dom": "^19.2.3",
    "react-hook-form": "^7.69.0",
    "react-is": "^19.2.4",
    "react-leaflet": "^5.0.0",
    "recharts": "^3.7.0",
    "resend": "^6.6.0",
    "server-only": "^0.0.1",
    "stripe": "^20.1.0",
    "swagger-ui-react": "^5.31.0",
    "tailwind-merge": "^3.4.0",
    "twilio": "^5.12.0",
    "use-debounce": "^10.0.6",
    "web-vitals": "^5.1.0",
    "zod": "^3.25.76",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.3.1",
    "@commitlint/config-conventional": "^20.3.1",
    "@faker-js/faker": "^10.2.0",
    "@next/bundle-analyzer": "^16.1.6",
    "@playwright/test": "^1.57.0",
    "@tailwindcss/postcss": "^4",
    "@tanstack/react-query-devtools": "^5.91.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/dompurify": "^3.0.5",
    "@types/jest": "^30.0.0",
    "@types/leaflet": "^1.9.21",
    "@types/lodash.merge": "^4.6.9",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-big-calendar": "^1.16.3",
    "@types/react-dom": "^19",
    "@types/supertest": "^6.0.3",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-react": "^5.18.0",
    "@vitejs/plugin-react": "^5.1.3",
    "@vitest/coverage-v8": "^4.0.17",
    "cloc": "^2.6.0-cloc",
    "drizzle-kit": "0.18.1",
    "eslint": "^9",
    "eslint-config-next": "^15.5.12",
    "eslint-plugin-unused-imports": "^4.3.0",
    "googleapis": "^169.0.0",
    "husky": "^9.1.7",
    "jsdom": "^27.4.0",
    "lint-staged": "^16.2.7",
    "madge": "^8.0.0",
    "msw": "^2.12.7",
    "nyc": "^17.1.0",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "source-map-explorer": "^2.5.3",
    "supertest": "^7.2.2",
    "swagger-jsdoc": "^6.2.8",
    "tailwindcss": "3.4.19",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "typescript-eslint": "^8.51.0",
    "vite": "^7.3.1",
    "vitest": "^4.0.17"
  }
}
