# Vete Platform - Environment Variables
# Copy this file to .env.local and fill in your values

# ==============================================================================
# SUPABASE CONFIGURATION [REQUIRED]
# ==============================================================================
# Get these from your Supabase project dashboard: Settings > API
# https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api

# Supabase project URL (e.g., https://xxxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url

# Supabase anonymous key - safe for client-side use (protected by RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Service role key (KEEP SECRET - server only, bypasses Row Level Security)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Database connection URL (from Supabase Settings > Database > Connection string > URI)
DATABASE_URL=your_database_connection_string

# ==============================================================================
# APPLICATION CONFIGURATION [OPTIONAL]
# ==============================================================================

# Your application's public URL (used for callbacks, emails, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Application name displayed in UI
NEXT_PUBLIC_APP_NAME=Vete

# Environment mode (development, production, test)
NODE_ENV=development

# ==============================================================================
# UPSTASH REDIS CONFIGURATION [REQUIRED for Rate Limiting]
# ==============================================================================
# Get these from your Upstash dashboard: https://console.upstash.com/
# Create a new Redis database and copy the REST API credentials

# Upstash Redis REST URL
UPSTASH_REDIS_REST_URL=your_upstash_redis_rest_url

# Upstash Redis REST Token
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token